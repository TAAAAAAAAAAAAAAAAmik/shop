# ---- Telegram ----------------------------------------------------------
# Получить у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

SHOP_NAME=Kinetix
SUPPORT_USERNAME=
CHANNEL_USERNAME=
REVIEWS_USERNAME=

# ---- Хранилище ---------------------------------------------------------
# SQLite — по умолчанию, годится для одного процесса.
DATABASE_URL=sqlite+aiosqlite:///data/kinetix.db
# PostgreSQL (нужен экстра `postgres`, поддерживает несколько воркеров):
# DATABASE_URL=postgresql+asyncpg://kinetix:kinetix@db:5432/kinetix

# ---- Деньги ------------------------------------------------------------
# Валюта магазина. Суммы ниже — в минорных единицах (копейки/центы).
CURRENCY=RUB
MIN_TOPUP=5000
MAX_TOPUP=10000000

# ---- Рефералы ----------------------------------------------------------
# Процент с каждого пополнения приглашённого
REFERRAL_PERCENT=5

# ---- Оплата: перевод по реквизитам (подтверждаете вручную) -------------
MANUAL_PAYMENT_ENABLED=true
# Текст с реквизитами, который увидит покупатель. \n — перенос строки.
# Можно не задавать здесь, а вписать прямо в боте: Админка → Реквизиты.
MANUAL_REQUISITES=
# Сколько живёт заявка до нажатия «Я оплатил», мин.
MANUAL_TTL_MINUTES=180

# ---- Оплата: криптовалюта (Crypto Pay API у @CryptoBot) ----------------
# Пусто = пополнение отключено, бот работает в режиме «только каталог».
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_TESTNET=false
PAYMENT_POLL_INTERVAL=15
INVOICE_TTL_MINUTES=60

# ---- Прочее ------------------------------------------------------------
DEFAULT_LOCALE=ru
THROTTLE_RATE=0.4
LOG_LEVEL=INFO
